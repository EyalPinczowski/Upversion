# API (apps/api). Names and safe example values only; never commit real values.

# operational | rnd
APP_ENV=operational
PORT=3000
HOST=0.0.0.0
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Comma separated list of exact origins allowed to call the API from a browser.
# Empty means no cross-origin access. Wildcards are rejected.
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=120
# Number of reverse proxies in front of the API (a whole number). 0 trusts nothing, so
# X-Forwarded-For is ignored and the rate limit keys on the connecting address.
# NEEDS CHECK: the correct hop count on Render is not verified yet; it is verified when the
# deployment branch is built. Maximum 5. Setting it higher than the real number of proxy hops lets
# clients spoof their IP and defeats the rate limit. Also needs check: entries written as
# [2001:db8::1] or 1.2.3.4:80 are keyed separately from the plain address, so verify the format
# Render writes at the same time. Leave 0 until then (all clients behind a proxy then share one limit).
TRUST_PROXY=0

# Accounts and sign-in (spec 3.A). Names only. The first three below are required when NODE_ENV=production, and so are SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY on the operational API only.
# See docs/setup/api-auth.md. Without them, sign-in rejects every token and account routes answer 503.
# development | test | production
NODE_ENV=development
# Supabase Auth public signing keys and the token issuer (both https, set both or neither).
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
# Connection string of the app_<schema> login (app_prod or app_rnd), never the admin account.
# Supabase project URL and the service-role (secret) key. Used only to delete the Supabase Auth
# user on "Delete my account". The key is a SERVER-ONLY secret: Render only, never Vercel, the web
# app or git. OPERATIONAL API ONLY (APP_ENV=operational): R&D shares the same Auth project, so the
# R&D API (APP_ENV=rnd) refuses to start if the key is set, and its "Delete my account" removes
# only R&D data. On operational both are required when NODE_ENV=production; set both or neither
# elsewhere (without them, account deletion answers 502 and deletes nothing).
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=postgres://app_rnd.<project-ref>:<password>@<pooler-host>:5432/postgres

# Feature flags: every flag is off. Booleans accept only the exact strings true or false.
# FEATURE_NOTIFICATIONS=true
# FEATURE_SHARING=true
# FEATURE_OFFLINE=true
# FEATURE_PUSH_NOTIFICATIONS=true
# FEATURE_AI_OVERVIEW=true
# First-time setup and the user profile (ADR 015). Off: the profile routes answer 404.
# FEATURE_PROFILE_SETUP=true
# Tailor my CV to a job with the free-tier AI gateway (ADR 016). Off: the route answers 404.
# FEATURE_CV_TAILOR=true
# Google Calendar (v0.3b), off by default. Refresh tokens are encrypted with AES-256-GCM.
# CALENDAR_TOKEN_KEYS: newest first, "<id>:<base64 of 32 random bytes>", comma separated. Required when
# FEATURE_CALENDAR=true (the API refuses to start without a valid key). Server-only secret, Render only.
# Generate one: openssl rand -base64 32. Rotate by adding a new id in front; keep old ones to decrypt.
# FEATURE_CALENDAR=true
# CALENDAR_TOKEN_KEYS=v2:<base64-32-bytes>,v1:<base64-32-bytes>
# Google OAuth client (Google Cloud console). Required when FEATURE_CALENDAR=true. Server-only secret.
# GOOGLE_CLIENT_ID=<oauth-client-id>
# GOOGLE_CLIENT_SECRET=<oauth-client-secret>
# Where Google returns the user after consent (the web app's callback page); must match an authorised redirect URI.
# GOOGLE_REDIRECT_URI=<web-origin>/calendar/callback
# Optional overrides (e2e points these at a local stub). Defaults are Google's own endpoints.
# GOOGLE_CALENDAR_API_BASE=https://www.googleapis.com/calendar/v3
# GOOGLE_OAUTH_BASE=https://oauth2.googleapis.com
# Paid AI providers are refused unless this is true. No paid provider exists; leave it off ($0 rule).
# Turning it on also needs a spending cap above 0, or the API refuses to start.
# AI_ALLOW_PAID=true
# AI_PAID_MONTHLY_CAP_USD=

# AI is off unless providers are listed. The order is the fallback order (groq, cloudflare-ai).
# A listed provider is used only when its own daily budget is set (calls per UTC day, 1 to 1000000);
# with no budget it is skipped. Budget variable: AI_BUDGET_<ID>_DAILY, e.g. AI_BUDGET_GROQ_DAILY.
# Provider credentials (never commit real values; see docs/setup/ai-providers.md):
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# Cloudflare stays off until the owner confirms no card was asked and the account shows Workers Free.
# CLOUDFLARE_FREE_PLAN_CONFIRMED=
# GROQ_API_KEY=
# Groq stays off until the owner has confirmed the free plan needs no card (then set to true).
# GROQ_NO_CARD_CONFIRMED=
# AI_PROVIDERS=
# AI_BUDGET_GROQ_DAILY=
# AI_BUDGET_CLOUDFLARE_AI_DAILY=
# Offline fake provider for R&D only (the operational API refuses to start with it).
# AI_FAKE_PROVIDER=true
# Per-attempt and whole-turn timeouts (ms), history size (characters) and per-user daily caps.
# AI_TIMEOUT_MS=15000
# AI_TURN_TIMEOUT_MS=25000
# AI_HISTORY_CHARS=12000
# AI_USER_DAILY_PRACTICE_MESSAGES=40
# AI_USER_DAILY_PRACTICE_FEEDBACK=6
# AI_USER_DAILY_OVERVIEW=1
# CV tailoring runs per user per UTC day, and across all users (counted from ai_usage_daily).
# AI_USER_DAILY_CV_TAILOR=3
# AI_CV_TAILOR_DAILY_TOTAL=20

# Web app variables live in apps/web/.env.example
