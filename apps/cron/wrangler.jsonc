{
  // Cron worker for the scheduled calendar sync (docs/calendar-cron.md). A separate Worker from the
  // web app (root wrangler.jsonc, name "upversion-web"): deploy it from this folder only.
  // "name" must equal the Worker name in the Cloudflare dashboard. The R&D worker is this file as is;
  // the operational one is a later, separate decision (owner approval) and needs its own name.
  "name": "upversion-cron-rnd",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-31",
  // No public URL: the worker only runs on its schedule.
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    // Every 15 minutes, UTC. Best effort: Cloudflare may start a run a little late.
    "crons": ["*/15 * * * *"],
  },
  "vars": {
    // Placeholder. Set the real origin of the R&D API (no trailing slash) in the Cloudflare
    // dashboard (Settings > Variables) or here before deploying. Not a secret.
    "API_BASE_URL": "https://<your-rnd-api>.onrender.com",
  },
  // The secret is NOT in this file. Set it once with:  npx wrangler secret put CALENDAR_CRON_SECRET
  // (run in apps/cron), or in the dashboard under Settings > Variables and Secrets.
}
